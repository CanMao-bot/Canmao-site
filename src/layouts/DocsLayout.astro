---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

const base = '/Canmao-site/';
interface Props {
  title: string;
  description?: string;
  current?: string; // 用于高亮侧边栏, 例如 /docs/guide/getting-started
}
const { title, description, current = '' } = Astro.props;

const sections = [
  {
    heading: '指南',
    items: [
      { href: `${base}docs/guide/getting-started`, label: '快速开始' },
      { href: `${base}docs/guide/features`, label: '特性总览' },
      { href: `${base}docs/guide/architecture`, label: '架构与目录' },
      { href: `${base}docs/guide/configuration`, label: '配置参考' },
    ],
  },
  {
    heading: '能力',
    items: [
      { href: `${base}docs/capabilities/memory`, label: '记忆' },
      { href: `${base}docs/capabilities/mood`, label: '心情' },
      { href: `${base}docs/capabilities/persona`, label: '人设' },
      { href: `${base}docs/capabilities/media`, label: '识图 / 画图 / 语音' },
      { href: `${base}docs/capabilities/web`, label: 'Web 搜索与浏览器' },
      { href: `${base}docs/capabilities/opencode`, label: '调用 opencode' },
    ],
  },
  {
    heading: '运维',
    items: [
      { href: `${base}docs/ops/commands`, label: '群内命令' },
      { href: `${base}docs/ops/providers`, label: '模型提供商' },
      { href: `${base}docs/ops/deployment`, label: '部署与 systemd' },
    ],
  },
];

// 展平为有序列表, 用于计算上一页/下一页
const flatNav = sections.flatMap((sec) => sec.items.map((item) => ({ href: item.href, label: item.label })));
const curIdx = flatNav.findIndex((n) => n.href === current.replace(/\/$/, ''));
const prev = curIdx > 0 ? flatNav[curIdx - 1] : null;
const next = curIdx >= 0 && curIdx < flatNav.length - 1 ? flatNav[curIdx + 1] : null;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body data-docpage>
    <Header />
    <div class="wrap docs-layout">
      <!-- 移动端抽屉遮罩 -->
      <div id="drawer-mask" class="drawer-mask" aria-hidden="true"></div>
      <aside class="docs-side" id="docs-side">
        <div class="dsearch"><Search /></div>
        {sections.map((sec) => (
          <div class="dsec">
            <div class="dsec-title">{sec.heading}</div>
            {sec.items.map((item) => (
              <a href={item.href} class:list={['dlink', { isActive: current === item.href }]}>
                {item.label}
              </a>
            ))}
          </div>
        ))}
      </aside>
      <main class="docs-main" data-pagefind-body>
        <!-- 移动端抽屉开关 -->
        <button id="drawer-btn" class="drawer-btn" aria-label="打开目录">
          <span class="db-icon">☰</span> 目录
        </button>
        <slot />
        <nav class="doc-pager" aria-label="文档翻页">
          {prev && (
            <a class="pager-link pager-prev" href={prev.href}>
              <span class="pager-label">← 上一篇</span>
              <span class="pager-title">{prev.label}</span>
            </a>
          )}
          {!prev && <span class="pager-link pager-empty"></span>}
          {next && (
            <a class="pager-link pager-next" href={next.href}>
              <span class="pager-label">下一篇 →</span>
              <span class="pager-title">{next.label}</span>
            </a>
          )}
          {!next && <span class="pager-link pager-empty"></span>}
        </nav>
      </main>
    </div>
    <Footer />
  </body>
</html>

<script>
  const btn = document.getElementById('drawer-btn');
  const mask = document.getElementById('drawer-mask');
  function closeDrawer() {
    document.body.classList.remove('drawer-open');
    btn?.setAttribute('aria-expanded', 'false');
  }
  btn?.addEventListener('click', () => {
    const open = document.body.classList.toggle('drawer-open');
    btn.setAttribute('aria-expanded', String(open));
  });
  mask?.addEventListener('click', closeDrawer);
  // 点击抽屉内链接后关闭
  document.querySelectorAll('#docs-side a').forEach((a) => a.addEventListener('click', closeDrawer));
  // 按 Esc 关闭
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
</script>

<style>
  .docs-layout { display: grid; grid-template-columns: 230px 1fr; gap: 3rem; padding-top: 2.5rem; padding-bottom: 3rem; }
  .docs-side { position: sticky; top: 80px; align-self: start; }
  .dsearch { margin-bottom: 1.2rem; }
  .dsec { margin-bottom: 1.6rem; }
  .dsec-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--pink-500); font-weight: 700; margin-bottom: 0.4rem; }
  .dlink { display: block; padding: 0.35rem 0.5rem; border-radius: 10px; color: var(--ink); opacity: 0.8; font-size: 0.95rem; }
  .dlink:hover { background: var(--pink-50); opacity: 1; text-decoration: none; }
  .dlink.isActive { background: var(--pink-100); color: var(--pink-600); font-weight: 700; opacity: 1; }
  .docs-main { min-width: 0; }
  .docs-main h1 { font-size: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
  .docs-main h2 { font-size: 1.5rem; margin-top: 2.4rem; }
  .docs-main h3 { font-size: 1.15rem; }
  .docs-main table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.95rem; }
  .docs-main th, .docs-main td { border: 1px solid var(--border); padding: 0.5rem 0.8rem; text-align: left; }
  .docs-main th { background: var(--pink-50); color: var(--pink-600); }
  .docs-main blockquote { border-left: 4px solid var(--pink-400); background: var(--pink-50); margin: 1rem 0; padding: 0.7rem 1rem; border-radius: 0 12px 12px 0; }
  .docs-main blockquote p { margin: 0; }
  .docs-main img { max-width: 100%; border-radius: 12px; }
  /* 上一篇/下一篇翻页 */
  .doc-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager-link {
    flex: 1;
    max-width: 48%;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.8rem 1rem;
    background: var(--surface);
    transition: all 0.18s ease;
  }
  .pager-link:hover {
    border-color: var(--pink-400);
    box-shadow: 0 6px 18px rgba(246, 82, 143, 0.14);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .pager-link.pager-next { align-items: flex-end; text-align: right; }
  .pager-empty { visibility: hidden; }
  .pager-label { font-size: 0.78rem; color: var(--pink-500); font-weight: 600; }
  .pager-title { font-weight: 700; color: var(--ink); }
  .pager-link:hover .pager-title { color: var(--pink-600); }
  .drawer-btn { display: none; }
  .drawer-mask { display: none; }
  @media (max-width: 860px) {
    .docs-layout { grid-template-columns: 1fr; gap: 1.2rem; padding-top: 1.5rem; padding-bottom: 4rem; }

    /* 抽屉样式：从左侧滑出 */
    .docs-side {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(300px, 82vw);
      z-index: 100;
      background: #fff;
      box-shadow: 6px 0 30px rgba(246, 82, 143, 0.2);
      padding: 1.4rem 1.2rem;
      overflow-y: auto;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      display: block;
    }
    body.drawer-open .docs-side { transform: translateX(0); }
    body.drawer-open { overflow: hidden; }

    /* 遮罩 */
    .drawer-mask {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(61, 40, 49, 0.4);
      z-index: 55;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    body.drawer-open .drawer-mask { opacity: 1; pointer-events: auto; }

    .dsearch { margin-bottom: 1rem; }
    .dsec { margin-bottom: 1.2rem; }
    .dsec-title { display: block; }
    .dlink { background: none; margin-right: 0; font-size: 0.95rem; padding: 0.4rem 0.6rem; }

    /* 头部目录开关按钮 */
    .drawer-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--pink-100);
      color: var(--pink-600);
      border: none;
      border-radius: 999px;
      padding: 0.45rem 1rem;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      margin-bottom: 0.8rem;
    }
    .drawer-btn:active { background: var(--pink-200); }

    .docs-main h1 { font-size: 1.6rem; }
    .docs-main h2 { font-size: 1.25rem; }
    .docs-main { overflow-x: auto; }
    .doc-pager { flex-direction: column; }
    .pager-link { max-width: 100%; }
    .pager-link.pager-next { align-items: flex-start; text-align: left; }
  }
</style>